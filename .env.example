# ---------------------------------------------------------------------------
# FastHand Status environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public Supabase project URL and anon key. Safe to expose to the browser;
# Row Level Security controls what can be read and written.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the check runner, the "Run check now" action, and the
# admin bootstrap script. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used for canonical metadata. Defaults to https://status.fasthandstudio.asia
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional for the check runner. Falls back to NEXT_PUBLIC_SUPABASE_URL.
# GitHub Actions stores this as a repository secret instead of an env file.
SUPABASE_URL=

# Optional runner tuning.
# CHECK_RETENTION_DAYS=120
# CHECK_SOURCE=manual
