# ---------------------------------------------------------------------------
# FastHand Status environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public Supabase project URL and anon key. Safe to expose to the browser;
# Row Level Security controls what can be read and written.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the check runner, the "Run check now" action, and the
# admin bootstrap script. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used for canonical metadata. Defaults to https://status.fasthandstudio.asia
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional for the check runner and admin bootstrap. Falls back to
# NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Optional runner tuning. Supabase pg_cron drives the five-minute schedule;
# CHECK_SOURCE only labels the rows that npm run checks writes.
# CHECK_RETENTION_DAYS=120
# CHECK_SOURCE=manual

# Optional. Groq API key for the ops desk draft writer. Without it the incident
# forms simply have no Draft button. Server-only; never prefix with NEXT_PUBLIC_.
GROQ=

# Optional. Which Groq model writes the draft. Defaults to llama-3.1-8b-instant,
# the free-tier model that is always available. Set it to llama-3.3-70b-versatile
# for longer-form wording.
# GROQ_MODEL=llama-3.1-8b-instant
